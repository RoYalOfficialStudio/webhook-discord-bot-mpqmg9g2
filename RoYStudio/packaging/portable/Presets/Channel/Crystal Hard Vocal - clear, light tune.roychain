      "name": "Light Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 35.0,
          "strength": 0.6,
          "threshold": 12.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
