          "band1Gain": 1.5,
          "band2Freq": 400.0,
          "band2Gain": -2.0,
          "band2Q": 0.8,
          "band3Freq": 3000.0,
          "band3Gain": 3.0,
          "band3Q": 0.8,
          "band4Freq": 8000.0,
          "band4Gain": 1.0,
          "highCut": 15000.0
        }
      }
    },
    {
