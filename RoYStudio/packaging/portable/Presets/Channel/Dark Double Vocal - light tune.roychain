{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "Dark Double Vocal - light tune",
  "created": "2026-09-29T00:00:00Z",
  "app": "0.2.0",
  "description": "Light autotune (40 ms, 45 %), DARK voice (warm low-mids, soft top end) and the voice sounds TWICE: a detuned double plus a quiet octave-down layer, spread wide by a chorus. Dark 1/4 delay, dark reverb, limiter at -1 dB. CLEAR-VOICE version: words stay understandable (presence up, mud out, effects kept behind the voice).",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Light Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 40.0,
          "strength": 0.45,
          "threshold": 15.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "Dark EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 90.0,
