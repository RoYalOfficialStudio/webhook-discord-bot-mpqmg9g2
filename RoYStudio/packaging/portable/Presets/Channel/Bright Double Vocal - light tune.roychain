{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "Bright Double Vocal - light tune",
  "created": "2026-09-29T00:00:00Z",
  "app": "0.2.0",
  "description": "Light autotune (40 ms, 45 %), BRIGHT voice (lean low end, lots of presence and air) and the voice sounds TWICE: a detuned double plus a quiet octave-up shimmer layer, spread wide by a chorus. Bright 1/4 delay, bright reverb, limiter at -1 dB. CLEAR-VOICE version: words stay understandable (presence up, mud out, effects kept behind the voice).",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Light Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 40.0,
          "strength": 0.45,
          "threshold": 15.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "Bright EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 120.0,
