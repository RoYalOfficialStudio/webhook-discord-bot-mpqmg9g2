          "band1Freq": 200.0,
          "band1Gain": -2.5,
          "band2Freq": 450.0,
          "band2Gain": -3.0,
          "band2Q": 1.2,
          "band3Freq": 4500.0,
          "band3Gain": 4.0,
          "band3Q": 0.7,
          "band4Freq": 12000.0,
          "band4Gain": 6.5,
          "highCut": 20000.0
        }
      }
    },
    {
