{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "Travis Style - Aggressive Rage Vocal",
  "created": "2026-09-29T00:00:00Z",
  "app": "0.2.0",
  "description": "Hard autotune (0 ms, robotic), bright EQ, heavy compression, tube grit + parallel distortion, stereo chorus, dotted-1/8 ping-pong delay, dark big reverb, limiter at -1 dB (protects your ears while monitoring). Autotune follows the song key. CLEAR-VOICE version: words stay understandable (presence up, mud out, effects kept behind the voice).",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Hard Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 0.0,
          "strength": 1.0,
          "threshold": 0.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "Rage EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 120.0,
          "lowCutSlope": 24.0,
          "band2Freq": 350.0,
          "band2Gain": -3.5,
          "band2Q": 1.2,
          "band3Freq": 3200.0,
          "band3Gain": 3.5,
          "band3Q": 0.8,
          "band4Freq": 10000.0,
          "band4Gain": 4.0,
          "highCut": 18000.0,
          "band1Gain": 0
        }
      }
    },
    {
      "typeId": "roy.compressor",
      "name": "Smash Comp",
      "bypass": false,
      "state": {
        "params": {
          "threshold": -24.0,
          "ratio": 6.0,
          "attack": 2.0,
          "release": 60.0,
          "knee": 3.0,
          "makeup": 14.0,
          "mix": 1.0
        }
      }
    },
    {
      "typeId": "roy.saturation",
      "name": "Tube Grit",
      "bypass": false,
      "state": {
        "params": {
          "drive": 12.0,
          "mode": 1.0,
          "tone": 12000.0,
          "mix": 0.35,
          "output": -5.0
        }
      }
    },
    {
      "typeId": "roy.distortion",
      "name": "Parallel Distortion",
      "bypass": false,
      "state": {
        "params": {
          "drive": 22.0,
          "mode": 1.0,
          "tone": 5000.0,
          "mix": 0.08,
          "output": -12.0
        }
      }
    },
    {
      "typeId": "roy.deesser",
      "name": "De-Esser",
      "bypass": false,
      "state": {
        "params": {
          "frequency": 6500.0,
          "threshold": -32.0,
          "range": 10.0
        }
      }
    },
    {
      "typeId": "roy.chorus",
      "name": "Wide Chorus",
      "bypass": false,
      "state": {
        "params": {
          "rate": 0.6,
          "depth": 2.5,
          "delay": 12.0,
          "feedback": 0.0,
          "mix": 0.18,
          "spread": 1.0
        }
      }
    },
    {
      "typeId": "roy.delay",
      "name": "Dotted 1/8 Ping-Pong",
      "bypass": false,
      "state": {
        "params": {
          "syncBeats": 0.75,
          "feedback": 0.35,
          "mix": 0.12,
          "pingPong": 1.0,
          "lowCut": 300.0,
          "highCut": 5000.0
        }
      }
    },
    {
      "typeId": "roy.reverb",
      "name": "Dark Space",
      "bypass": false,
      "state": {
        "params": {
          "decay": 2.8,
          "preDelay": 40.0,
          "size": 1.4,
          "damping": 0.6,
          "width": 1.0,
          "mix": 0.12,
          "lowCut": 350.0
        }
      }
    },
    {
      "typeId": "roy.limiter",
      "name": "Safety Limiter",
      "bypass": false,
      "state": {
        "params": {
          "ceiling": -1.0,
          "release": 60.0,
          "lookahead": 1.5,
          "truePeak": 1.0,
          "inputGain": 0.0
        }
      }
    }
  ]
