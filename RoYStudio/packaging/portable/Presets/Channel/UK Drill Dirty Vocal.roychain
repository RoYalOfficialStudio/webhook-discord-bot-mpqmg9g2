{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "UK Drill Dirty Vocal",
  "created": "2026-09-29T00:00:00Z",
  "app": "0.2.0",
  "description": "Dirtier than US Street: UK drill / grime vocal. Barely any autotune (keeps the raw voice), narrow gritty mid-range EQ, very hard compression, heavy tube grit + more distortion, de-esser, dark 1/8 delay, almost dry, limiter at -1 dB. CLEAR-VOICE version: words stay understandable (presence up, mud out, effects kept behind the voice).",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Light Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 45.0,
          "strength": 0.4,
          "threshold": 20.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "Grime EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 130,
          "lowCutSlope": 24.0,
          "band1Freq": 300.0,
          "band1Gain": -2.0,
          "band2Freq": 500,
          "band2Gain": -2.0,
          "band2Q": 0.8,
          "band3Freq": 3200.0,
          "band3Gain": 3.5,
          "band3Q": 1.0,
          "band4Freq": 9000.0,
          "band4Gain": 1.0,
          "highCut": 15000.0
        }
      }
    },
    {
      "typeId": "roy.compressor",
      "name": "Crush Comp",
      "bypass": false,
      "state": {
        "params": {
          "threshold": -30.0,
          "ratio": 12.0,
          "attack": 1.0,
          "release": 45.0,
          "knee": 1.0,
          "makeup": 17.0,
          "mix": 1.0
        }
      }
    },
    {
      "typeId": "roy.saturation",
      "name": "Heavy Grit",
      "bypass": false,
      "state": {
        "params": {
          "drive": 16.0,
          "mode": 1.0,
          "tone": 9000.0,
          "mix": 0.35,
          "output": -5.0
        }
      }
    },
    {
      "typeId": "roy.distortion",
      "name": "Dirt",
      "bypass": false,
      "state": {
        "params": {
          "drive": 26.0,
          "mode": 1.0,
          "tone": 4000.0,
          "mix": 0.08,
          "output": -12.0
        }
      }
    },
    {
      "typeId": "roy.deesser",
      "name": "De-Esser",
      "bypass": false,
      "state": {
        "params": {
          "frequency": 6000.0,
          "threshold": -32.0,
          "range": 10.0
        }
      }
    },
    {
      "typeId": "roy.delay",
      "name": "Dark 1/8",
      "bypass": false,
      "state": {
        "params": {
          "syncBeats": 0.5,
          "feedback": 0.22,
          "mix": 0.1,
          "pingPong": 1.0,
          "lowCut": 400.0,
          "highCut": 4000.0
        }
      }
    },
    {
      "typeId": "roy.reverb",
      "name": "Dry Room",
      "bypass": false,
      "state": {
        "params": {
          "decay": 0.6,
          "preDelay": 8.0,
          "size": 0.5,
          "damping": 0.6,
          "width": 0.7,
          "mix": 0.05,
          "lowCut": 450.0
        }
      }
    },
    {
      "typeId": "roy.limiter",
      "name": "Safety Limiter",
      "bypass": false,
      "state": {
        "params": {
          "ceiling": -1.0,
          "release": 45.0,
          "lookahead": 1.5,
          "truePeak": 1.0,
          "inputGain": 0.0
        }
      }
    }
  ]
}
