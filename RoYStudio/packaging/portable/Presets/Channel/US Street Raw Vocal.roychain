{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "US Street Raw Vocal",
  "created": "2026-09-29T00:00:00Z",
  "app": "0.2.0",
  "description": "Raw American street / drill vocal: dry and in your face, loud and gritty. Punchy autotune (15 ms, 70 %), mid-heavy EQ with bite, hard compression, tube grit + a little distortion, de-esser, short slapback delay, almost no reverb, limiter at -1 dB. CLEAR-VOICE version: words stay understandable (presence up, mud out, effects kept behind the voice).",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Street Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 15.0,
          "strength": 0.7,
          "threshold": 10.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "Bite EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 130,
          "lowCutSlope": 24.0,
          "band1Freq": 250.0,
          "band1Gain": -1.0,
          "band2Freq": 500,
          "band2Gain": -2.0,
          "band2Q": 0.9,
          "band3Freq": 2800,
          "band3Gain": 4.5,
          "band3Q": 0.9,
          "band4Freq": 10000.0,
          "band4Gain": 2.0,
          "highCut": 16000.0
        }
      }
    },
    {
      "typeId": "roy.compressor",
      "name": "Hard Comp",
      "bypass": false,
      "state": {
        "params": {
          "threshold": -27.0,
          "ratio": 8.0,
          "attack": 1.5,
          "release": 50.0,
          "knee": 2.0,
          "makeup": 14.0,
          "mix": 1.0
        }
      }
    },
    {
      "typeId": "roy.saturation",
      "name": "Tube Grit",
      "bypass": false,
      "state": {
        "params": {
          "drive": 12.0,
          "mode": 1.0,
          "tone": 11000.0,
          "mix": 0.35,
          "output": -3.0
        }
      }
    },
    {
      "typeId": "roy.distortion",
      "name": "Dirt",
      "bypass": false,
      "state": {
        "params": {
          "drive": 18.0,
          "mode": 1.0,
          "tone": 4500.0,
          "mix": 0.08,
          "output": -12.0
        }
      }
    },
    {
      "typeId": "roy.deesser",
      "name": "De-Esser",
      "bypass": false,
      "state": {
        "params": {
          "frequency": 6200.0,
          "threshold": -32.0,
          "range": 10.0
        }
      }
    },
    {
      "typeId": "roy.delay",
      "name": "Slapback",
      "bypass": false,
      "state": {
        "params": {
          "time": 95.0,
          "syncBeats": 0.0,
          "feedback": 0.12,
          "mix": 0.12,
          "pingPong": 0.0,
          "lowCut": 300.0,
          "highCut": 5000.0
        }
      }
    },
    {
      "typeId": "roy.reverb",
      "name": "Tiny Room",
      "bypass": false,
      "state": {
        "params": {
          "decay": 0.7,
          "preDelay": 10.0,
          "size": 0.6,
          "damping": 0.5,
          "width": 0.8,
          "mix": 0.06,
          "lowCut": 400.0
        }
      }
    },
    {
      "typeId": "roy.limiter",
      "name": "Safety Limiter",
      "bypass": false,
      "state": {
        "params": {
          "ceiling": -1.0,
          "release": 50.0,
          "lookahead": 1.5,
          "truePeak": 1.0,
          "inputGain": 0.0
        }
      }
    }
  ]
}
