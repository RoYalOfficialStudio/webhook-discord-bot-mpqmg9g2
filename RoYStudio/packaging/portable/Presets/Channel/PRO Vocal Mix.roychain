{
  "format": "roy.channelPreset",
  "version": 1,
  "name": "PRO Vocal Mix",
  "created": "2026-09-30T00:00:00Z",
  "app": "0.2.0",
  "description": "Studio-style vocal chain like mixing engineers use: transparent tune, subtractive EQ (clean low end, mud out), two compressors in series (fast one catches peaks, slow one levels the performance), de-esser, additive EQ for presence and air, light tape warmth, short 1/8 delay and small plate reverb tucked behind the voice, limiter at -1 dB.",
  "inserts": [
    {
      "typeId": "roy.vocaltune",
      "name": "Transparent Tune",
      "bypass": false,
      "state": {
        "params": {
          "speed": 25.0,
          "strength": 0.7,
          "threshold": 10.0,
          "offKeyFilter": 1.0,
          "allowChromatic": 0.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "1 Clean-up EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 90.0,
          "lowCutSlope": 24.0,
          "band1Freq": 200.0,
          "band1Gain": -1.0,
          "band2Freq": 350.0,
          "band2Gain": -3.0,
          "band2Q": 1.4,
          "band3Freq": 800.0,
          "band3Gain": -1.5,
          "band3Q": 1.5,
          "band4Freq": 12000.0,
          "band4Gain": 0.0,
          "highCut": 20000.0
        }
      }
    },
    {
      "typeId": "roy.compressor",
      "name": "2 Peak Comp (fast)",
      "bypass": false,
      "state": {
        "params": {
          "threshold": -18.0,
          "ratio": 4.0,
          "attack": 2.0,
          "release": 50.0,
          "knee": 3.0,
          "makeup": 4.0,
          "mix": 1.0
        }
      }
    },
    {
      "typeId": "roy.compressor",
      "name": "3 Level Comp (slow)",
      "bypass": false,
      "state": {
        "params": {
          "threshold": -20.0,
          "ratio": 2.5,
          "attack": 20.0,
          "release": 200.0,
          "knee": 8.0,
          "makeup": 5.0,
          "mix": 1.0
        }
      }
    },
    {
      "typeId": "roy.deesser",
      "name": "4 De-Esser",
      "bypass": false,
      "state": {
        "params": {
          "frequency": 6800.0,
          "threshold": -34.0,
          "range": 10.0
        }
      }
    },
    {
      "typeId": "roy.eq",
      "name": "5 Presence + Air EQ",
      "bypass": false,
      "state": {
        "params": {
          "lowCut": 20.0,
          "lowCutSlope": 12.0,
          "band1Freq": 100.0,
          "band1Gain": 0.0,
          "band2Freq": 1500.0,
          "band2Gain": 0.5,
          "band2Q": 0.8,
          "band3Freq": 3800.0,
          "band3Gain": 2.5,
          "band3Q": 0.8,
          "band4Freq": 12000.0,
          "band4Gain": 4.0,
          "highCut": 20000.0
        }
      }
    },
    {
      "typeId": "roy.saturation",
      "name": "6 Tape Warmth",
      "bypass": false,
      "state": {
        "params": {
          "drive": 3.0,
          "mode": 0.0,
          "tone": 16000.0,
          "mix": 0.2,
          "output": -0.5
        }
      }
    },
    {
      "typeId": "roy.delay",
      "name": "7 Short 1/8 Delay",
      "bypass": false,
      "state": {
        "params": {
          "syncBeats": 0.5,
          "feedback": 0.2,
          "mix": 0.07,
          "pingPong": 1.0,
          "lowCut": 500.0,
          "highCut": 5000.0
        }
      }
    },
    {
      "typeId": "roy.reverb",
      "name": "8 Small Plate",
      "bypass": false,
      "state": {
        "params": {
          "decay": 1.2,
          "preDelay": 25.0,
          "size": 0.8,
          "damping": 0.3,
          "width": 1.0,
          "mix": 0.08,
          "lowCut": 500.0
        }
      }
    },
    {
      "typeId": "roy.limiter",
      "name": "9 Safety Limiter",
      "bypass": false,
      "state": {
        "params": {
          "ceiling": -1.0,
          "release": 60.0,
          "lookahead": 1.5,
          "truePeak": 1.0,
          "inputGain": 0.0
        }
      }
    }
  ]
}
